# 이 파일을 복사해 .env 로 만들고 실제 키 값을 채우세요.
#   cp .env.example .env
# .env 는 .gitignore 에 포함되어 있어 저장소에 커밋되지 않습니다.
# 실제 키 값은 절대 코드/README/결과물에 직접 작성하지 마세요.

# --- LLM (택1) ---
# OpenAI 계열
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Google Gemini 계열
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash

# --- 지도/장소 검색 (택1) ---
# Kakao Local
KAKAO_REST_API_KEY=

# Naver Local Search
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
